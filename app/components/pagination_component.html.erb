<% if total_pages > 1 %>
  <nav class="pagination">
    <% if prev_page? %>
      <%= link_to "← Prev", "?page=#{current_page - 1}", class: "page-link" %>
    <% end %>
    <% page_range.each do |page| %>
      <%= link_to page, "?page=#{page}", class: "page-link #{'active' if page == current_page}" %>
    <% end %>
    <% if next_page? %>
      <%= link_to "Next →", "?page=#{current_page + 1}", class: "page-link" %>
    <% end %>
  </nav>
<% end %>
